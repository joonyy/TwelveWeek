DATABASE_URL=postgresql://twelve:twelve_local@127.0.0.1:55439/twelve_week
TEST_DATABASE_URL=postgresql://twelve:twelve_local@127.0.0.1:55439/twelve_week_test
DATABASE_SSL=false
# Aiven: enable TLS and supply your project's CA file or PEM.
# DATABASE_CA_PATH=/etc/secrets/aiven-ca.pem
# DATABASE_CA_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
PORT=4110
WEB_ORIGIN=http://localhost:5178
TOKEN_TTL_DAYS=365
NODE_ENV=development
# Blank uses local Vite proxy. Production: https://your-api.onrender.com
VITE_API_BASE_URL=

# Vision AI: generate a stable random secret of at least 32 characters before saving users' API keys.
# Never put these in VITE_* variables or commit .env.
AI_SECRETS_KEY=
# Public API and frontend URLs used by MCP OAuth (HTTPS in production).
API_PUBLIC_URL=http://127.0.0.1:4110
WEB_PUBLIC_URL=http://127.0.0.1:5178
# Optional shared server credentials. Otherwise users connect their own API key in the app.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional local-only Codex bridge. Bind to exactly one TwelveWeek profile UUID.
# It uses that computer's Codex login/thread history; it is disabled in production.
CODEX_PROFILE_ID=
CODEX_BIN=codex
# Codex 앱에서 이미 열어둔 대화는 같은 로컬 daemon의 Unix socket에 연결합니다.
CODEX_SOCKET_PATH=
